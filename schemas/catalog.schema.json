{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonit-dev/threenative-game-refs/catalog.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "platform",
      "repo",
      "tier",
      "kind"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\s*$)(?![\\s\\S]*(?:```|~~~))[\\s\\S]+$"
      },
      "platform": {
        "type": "string",
        "enum": [
          "3DO",
          "Amiga",
          "Amstrad CPC",
          "Apple II",
          "Arcade",
          "Atari 2600",
          "Atari 8-bit",
          "Atari Jaguar",
          "Atari Lynx",
          "Atari ST",
          "BBC Micro / Acorn",
          "ColecoVision",
          "Commodore 64",
          "Commodore VIC-20",
          "Dreamcast",
          "Game Boy",
          "Game Boy Advance",
          "Game Boy Color",
          "Game Gear",
          "GameCube",
          "MSX",
          "Mac",
          "Master System",
          "Mobile",
          "NES / Famicom",
          "Neo Geo",
          "Nintendo 3DS",
          "Nintendo 64",
          "Nintendo DS",
          "Nintendo Switch",
          "PC / DOS",
          "PC-98",
          "Philips CD-i",
          "PlayStation",
          "PlayStation 2",
          "PlayStation 3",
          "PlayStation 4",
          "PlayStation 5",
          "PlayStation Portable",
          "SNES / Super Famicom",
          "Sega 32X",
          "Sega CD",
          "Sega Genesis / Mega Drive",
          "Sega Saturn",
          "Virtual Boy",
          "Web / Flash",
          "Wii",
          "Wii U",
          "Xbox",
          "Xbox 360",
          "Xbox One",
          "ZX Spectrum",
          "unknown"
        ]
      },
      "repo": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\s*$)(?![\\s\\S]*(?:```|~~~))[\\s\\S]+$"
      },
      "tier": {
        "type": "integer",
        "enum": [
          1,
          2
        ]
      },
      "rating": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "genre": {
        "type": "string",
        "enum": [
          "platformer",
          "action-adventure",
          "rpg",
          "shooter",
          "racing",
          "fighting",
          "strategy",
          "simulation",
          "puzzle",
          "sports",
          "rhythm",
          "horror",
          "stealth",
          "party"
        ]
      },
      "subgenre": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "decompilation",
          "disassembly",
          "static-recompilation",
          "port",
          "source-port",
          "browser-port",
          "engine-reimplementation",
          "system-software",
          "original-source"
        ]
      }
    }
  }
}

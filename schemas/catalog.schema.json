{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonit-dev/threenative-game-refs/catalog.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "platform",
      "repo",
      "tier"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\s*$)(?![\\s\\S]*(?:```|~~~))[\\s\\S]+$"
      },
      "platform": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\s*$)(?![\\s\\S]*(?:```|~~~))[\\s\\S]+$"
      },
      "repo": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\s*$)(?![\\s\\S]*(?:```|~~~))[\\s\\S]+$"
      },
      "tier": {
        "type": "integer",
        "enum": [
          1,
          2
        ]
      },
      "rating": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "genre": {
        "type": "string",
        "enum": [
          "platformer",
          "action-adventure",
          "rpg",
          "shooter",
          "racing",
          "fighting",
          "strategy",
          "simulation",
          "puzzle",
          "sports",
          "rhythm",
          "horror",
          "stealth",
          "party"
        ]
      },
      "subgenre": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
      }
    }
  }
}
